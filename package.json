{
  "name": "pkp-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server for finding Polish trains, powered by the PKP PLK Open Data API",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pkp-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "gen:api": "openapi-typescript docs/api/openapi.json -o src/api/generated.ts && biome format --write src/api/generated.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.19.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
